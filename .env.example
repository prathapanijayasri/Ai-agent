# MediBot AI Configuration Template

# Server Configuration
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=False
SECRET_KEY=change-this-to-a-secure-random-secret-key

# Vector Database & Embeddings
CHROMA_PERSIST_DIR=/app/chroma_db
KNOWLEDGE_BASE_DIR=/app/knowledge_base
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=1.35

# Upload Security & Access Control
MAX_UPLOAD_SIZE_MB=10
ADMIN_API_KEY=your_optional_admin_secret_key_here

# AI Model Provider Configuration
# Options: auto | offline | gemini | openai | huggingface
# In 'auto' mode, if no API key is set, it defaults to the verified offline RAG synthesizer.
LLM_PROVIDER=auto

# Optional: Google Gemini API (Recommended if using cloud LLM)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Optional: Hugging Face Inference API
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=google/flan-t5-base
